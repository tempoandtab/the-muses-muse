STYLE_SETTINGS_BODY_CLASSES=theme-dark mod-linux is-frameless is-hidden-frameless obsidian-app styled-scrollbars show-inline-title is-floating-nav auto-full-screen show-ribbon show-view-header css-settings-manager sync-embeds-hide-linked-mentions sheet-music-hide-translations mdrazor-mouse-line-highlight-enabled mdrazor-current-line-highlight accented-interface material-light contrast-light material-dark contrast-dark layout-baseline input-material status-bar-cupertino tab-default tab-full-width tab-stack-top view-header-title-always tab-top-left-icon tab-left-compact tab-top-right-icon tab-right-compact nav-action-dot nav-item-strong colorful-folders-off focus-view active-line-off active-line-color-default table-normal bases-normal img-normal metadata-default metadata-add-property-always colorful-headings-off colorful-headings-text bases-row-alt blockquote-baseline callouts-padded code-default embed-side media-width-full pdf-shadow table-width-full AT-row is-maximized is-focused
